<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:mood_moments.ViewModels.MoodEntryWizard"
             x:Class="mood_moments.Views.MoodEntryWizard.ContextStep"
             x:Name="ContextStepRoot"
             x:DataType="viewModels:ContextStepViewModel">
    <StackLayout>
        <Label x:Name="ContextStepHeaderLabel"
               Text="Step 6: Context"
               FontSize="22"
               FontAttributes="Bold"
               FontAutoScalingEnabled="True"
               SemanticProperties.HeadingLevel="Level1"
               SemanticProperties.Description="Context Step Heading" />
        <Label Text="Select the context for your mood entry."
               FontSize="14"
               FontAutoScalingEnabled="True"
               SemanticProperties.Hint="This is a required step. Use arrow keys or touch to select."
               IsVisible="True" />
        <CollectionView ItemsSource="{Binding ContextOptions}"
                        SelectedItem="{Binding Context, Mode=TwoWay}"
                        SelectionMode="Single"
                        AutomationId="ContextOptionsCollectionView">
            <CollectionView.EmptyView>
                <Label Text="No context options available." FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:ContextOptionViewModel">
                    <Grid Padding="8">
                        <Label Text="{Binding Name}" FontSize="16" VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentView>
