<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:mood_moments.ViewModels.MoodEntryWizard"
             x:Class="mood_moments.Views.MoodEntryWizard.TriggerStep"
             x:Name="TriggerStepRoot"
             x:DataType="viewModels:TriggerStepViewModel">
    <StackLayout>
        <Label x:Name="TriggerStepHeaderLabel"
               Text="Step 7: Triggers"
               FontSize="22"
               FontAttributes="Bold"
               FontAutoScalingEnabled="True"
               SemanticProperties.HeadingLevel="Level1"
               SemanticProperties.Description="Triggers Step Heading" />
        <Label Text="Select all triggers that apply."
               FontSize="14"
               FontAutoScalingEnabled="True"
               SemanticProperties.Hint="You can select multiple triggers. Use spacebar or tap to toggle."
               IsVisible="True" />
        <CollectionView ItemsSource="{Binding GroupedTriggers}"
                        IsGrouped="True"
                        AutomationId="TriggerOptionsCollection"
                        SemanticProperties.Description="Trigger options grouped list"
                        SemanticProperties.Hint="Select one or more triggers. Use spacebar or tap to toggle.">
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="viewModels:TriggerGroup">
                    <StackLayout Orientation="Horizontal" Padding="8,4">
                        <Label Text="{Binding Category}" FontAttributes="Bold" FontAutoScalingEnabled="True" />
                        <Label Text="({Binding Triggers.Count})" FontSize="12" Margin="8,0,0,0" FontAutoScalingEnabled="True" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:TriggerItem">
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                 AutomationId="TriggerCheckBox"
                                 SemanticProperties.Description="{Binding Name}"
                                 SemanticProperties.Hint="Check to select this trigger."
                                 />
                        <Label Text="{Binding Name}" FontSize="14" VerticalOptions="Center" FontAutoScalingEnabled="True" />
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentView>
