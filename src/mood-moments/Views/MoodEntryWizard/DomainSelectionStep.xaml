<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:mood_moments.ViewModels.MoodEntryWizard"
             xmlns:models="clr-namespace:mood_moments.Models"
             x:Class="mood_moments.Views.MoodEntryWizard.DomainSelectionStep"
             x:Name="DomainSelectionStepRoot"
             x:DataType="viewModels:DomainSelectionViewModel">
    <StackLayout>
        <Label Text="Select a Life Domain" FontSize="22" FontAttributes="Bold"
               SemanticProperties.HeadingLevel="Level1"
               SemanticProperties.Description="Domain Selection Step Heading" />
        <CollectionView ItemsSource="{Binding Domains}" SelectionMode="Single" SelectedItem="{Binding SelectedDomain, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:DomainInfo">
                    <Frame Margin="4" Padding="8" BorderColor="Gray" HasShadow="True">
                        <StackLayout>
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18" />
                            <Label Text="{Binding Description}" FontSize="14" />
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentView>
