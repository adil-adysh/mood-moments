<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:mood_moments.ViewModels"
             x:Class="mood_moments.Views.MoodEntryWizard.MidEmotionStep"
             x:Name="MidEmotionStepRoot"
             x:DataType="viewModels:NewEntryWizardViewModel">
    <StackLayout Padding="10" Spacing="15">
        <Label Text="{Binding StepTitle}" FontSize="22" FontAttributes="Bold" />
        <Label Text="Select a more specific emotion" FontSize="18" FontAttributes="Bold" />
        <CollectionView ItemsSource="{Binding EmotionSelection.MidEmotions}" SelectionMode="Single" x:Name="MidEmotionsCollection" SemanticProperties.Description="Mid emotion options">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <RadioButton Content="{Binding .}"
                                 GroupName="MidEmotionsGroup"
                                 CheckedChanged="OnMidEmotionCheckedChanged"
                                 SemanticProperties.Description="{Binding .}"
                                 AutomationId="{Binding .}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Text="Skip to Intensity"
                Command="{Binding SkipToIntensityCommand}"
                Margin="0,10,0,0"
                HorizontalOptions="Center"
                SemanticProperties.Description="Skip to intensity selection"
                AutomationId="SkipToIntensityButton" />
    </StackLayout>
</ContentView>
