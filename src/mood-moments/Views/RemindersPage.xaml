<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:mood_moments.ViewModels"
             x:Class="mood_moments.Views.RemindersPage"
             x:Name="RemindersPageRoot"
             Title="Reminders"
             x:DataType="viewModels:RemindersViewModel">
    <StackLayout Padding="20">
        <Label x:Name="RemindersHeaderLabel"
               Text="Reminders"
               FontSize="24"
               FontAttributes="Bold"
               FontAutoScalingEnabled="True"
               SemanticProperties.HeadingLevel="Level1"
               SemanticProperties.Description="Reminders main heading" />
        <CollectionView x:Name="RemindersList"
                        Margin="0,10,0,0"
                        ItemsSource="{Binding Reminders}"
                        AutomationProperties.LabeledBy="{x:Reference RemindersHeaderLabel}"
                        SemanticProperties.Description="List of reminders">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:ReminderViewModel">
                    <Border Margin="0,4,0,4" Stroke="LightGray" StrokeThickness="1" BackgroundColor="White" StrokeShape="RoundRectangle 8">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Label Text="\u23f0" FontSize="20" FontAutoScalingEnabled="True" SemanticProperties.Description="Reminder icon" />
                            <Label Text="{Binding Display}" FontSize="18" FontAutoScalingEnabled="True" SemanticProperties.Description="{Binding Display}" />
                            <Button Text="Delete"
                                    Command="{Binding BindingContext.DeleteReminderCommand, Source={x:Reference Name=RemindersPageRoot}}"
                                    CommandParameter="{Binding .}"
                                    FontSize="13"
                                    SemanticProperties.Description="Delete this reminder"
                                    AutomationId="DeleteReminderButton">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#D6EAF8" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Button>
                        </StackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Text="Add Reminder"
                Command="{Binding ShowAddReminderDialogCommand}"
                FontAutoScalingEnabled="True"
                SemanticProperties.Description="Show add reminder dialog"
                SemanticProperties.Hint="Opens the add reminder dialog."
                AutomationId="AddReminderButton" />
        <Grid IsVisible="{Binding IsAddReminderDialogVisible}" BackgroundColor="#80000000"
              SemanticProperties.Description="Add reminder dialog overlay">
            <Border Padding="20" BackgroundColor="White" StrokeShape="RoundRectangle 12" VerticalOptions="Center" HorizontalOptions="Center">
                <StackLayout Orientation="Vertical" Spacing="12" SemanticProperties.Description="Add reminder dialog content">
                    <Label x:Name="AddReminderHeaderLabel"
                           Text="Add Reminder"
                           FontSize="20"
                           FontAttributes="Bold"
                           FontAutoScalingEnabled="True"
                           SemanticProperties.HeadingLevel="Level2"
                           SemanticProperties.Description="Add reminder dialog heading" />
                    <Entry Placeholder="Reminder text"
                           Text="{Binding NewReminderText}"
                           WidthRequest="160"
                           AutomationProperties.LabeledBy="{x:Reference AddReminderHeaderLabel}"
                           SemanticProperties.Description="Reminder text input"
                           SemanticProperties.Hint="Enter the reminder text."
                           AutomationId="ReminderTextEntry" />
                    <StackLayout Orientation="Horizontal" Spacing="8">
                        <Picker Title="Hour"
                                ItemsSource="{Binding Hours}"
                                SelectedItem="{Binding Hour}"
                                WidthRequest="60"
                                SemanticProperties.Description="Hour picker"
                                SemanticProperties.Hint="Select the hour."
                                AutomationId="HourPicker" />
                        <Picker Title="Minute"
                                ItemsSource="{Binding Minutes}"
                                SelectedItem="{Binding Minute}"
                                WidthRequest="60"
                                SemanticProperties.Description="Minute picker"
                                SemanticProperties.Hint="Select the minute."
                                AutomationId="MinutePicker" />
                        <StackLayout Orientation="Horizontal" Spacing="0">
                            <RadioButton Content="AM" GroupName="ampm" IsChecked="{Binding IsPm, Converter={StaticResource InverseBoolConverter}}"
                                         SemanticProperties.Description="AM"
                                         SemanticProperties.Hint="Select AM."
                                         AutomationId="AMRadioButton" />
                            <RadioButton Content="PM" GroupName="ampm" IsChecked="{Binding IsPm}"
                                         SemanticProperties.Description="PM"
                                         SemanticProperties.Hint="Select PM."
                                         AutomationId="PMRadioButton" />
                        </StackLayout>
                    </StackLayout>
                    <StackLayout Orientation="Horizontal" Spacing="10" HorizontalOptions="End">
                        <Button Text="Cancel"
                                Command="{Binding HideAddReminderDialogCommand}"
                                FontAutoScalingEnabled="True"
                                SemanticProperties.Description="Cancel add reminder"
                                SemanticProperties.Hint="Close the add reminder dialog."
                                AutomationId="CancelAddReminderButton" />
                        <Button Text="Add"
                                Command="{Binding AddReminderCommand}"
                                FontAutoScalingEnabled="True"
                                SemanticProperties.Description="Confirm add reminder"
                                SemanticProperties.Hint="Add the new reminder."
                                AutomationId="ConfirmAddReminderButton" />
                    </StackLayout>
                </StackLayout>
            </Border>
        </Grid>
    </StackLayout>
</ContentPage>
