<?xml version="1.0" encoding="utf-8" ?>
<!--
    This is a .NET MAUI ContentPage for the New Entry Wizard.
    - ContentPage: Represents a single page of your app's UI.
    - xmlns: XML namespaces for XAML, including custom namespaces for ViewModels and Views.
    - x:Class: Links this XAML to its code-behind file.
    - Title: Sets the page title (shown in navigation bars).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:mood_moments.ViewModels"
             xmlns:views="clr-namespace:mood_moments.Views"
             xmlns:mew="clr-namespace:mood_moments.Views.MoodEntryWizard"
             x:Class="mood_moments.Views.NewEntryWizardPage"
             Title="New Mood Entry">
    <!--
        Sets the BindingContext for this page to an instance of NewEntryWizardViewModel.
        This enables data binding between the ViewModel and the UI controls.
    -->
    <ContentPage.BindingContext>
        <viewModels:NewEntryWizardViewModel/>
    </ContentPage.BindingContext>
    <!--
        The main content of the page is a Grid with three rows:
        - Auto: For the step title and content.
        - *: For the dynamic content area (StepHost).
        - Auto: For the bottom navigation bar.
    -->
    <ContentPage.Content>
        <Grid RowDefinitions="Auto,*,Auto">
            <!--
                The first row contains the step title and content.
                - StackLayout: A layout that arranges its children vertically.
                - Padding: Adds space around the content.
            -->
            <StackLayout Padding="20" Grid.Row="0">
                <!--
                    Label bound to the StepTitle property of the ViewModel.
                    - Text: Uses data binding to display the current step's title.
                    - FontSize and FontAttributes: Style the label as a heading.
                -->
                <Label Text="{Binding StepTitle}"
                       FontSize="24"
                       FontAttributes="Bold"/>
                <!--
                    ContentView named StepHost acts as a placeholder for the current step's content.
                    The actual content is likely swapped dynamically in the code-behind or ViewModel.
                -->
                <ContentView x:Name="StepHost"/>
            </StackLayout>
            <!--
                The third row is a bottom navigation bar with buttons for navigation.
                - Grid: A flexible layout that arranges its children in rows and columns.
                - BackgroundColor: Sets the background color of the bar.
                - Padding: Adds space inside the bar.
                - VerticalOptions: Aligns the bar at the bottom.
            -->
            <Grid Grid.Row="2" BackgroundColor="{DynamicResource SecondaryColor}" Padding="10,5" VerticalOptions="End">
                <!--
                    Defines four columns for the navigation buttons.
                    - ColumnDefinition: Specifies the width of each column.
                -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--
                    Back button
                    - Command: Binds to the BackStepCommand in the ViewModel.
                    - IsVisible: Binds to the CanExecute property of the command, controlling visibility.
                -->
                <Button Text="Back"
                        Command="{Binding BackStepCommand}"
                        IsVisible="{Binding BackStepCommand.CanExecute, Mode=OneWay}"
                        Grid.Column="0" />
                <!--
                    Next button
                    - Command: Binds to the NextStepCommand in the ViewModel.
                    - IsVisible: Binds to the CanExecute property of the command, controlling visibility.
                -->
                <Button Text="Next"
                        Command="{Binding NextStepCommand}"
                        IsVisible="{Binding NextStepCommand.CanExecute, Mode=OneWay}"
                        Grid.Column="2" />
                <!--
                    Finish button
                    - Command: Binds to the FinishCommand in the ViewModel.
                    - IsVisible: Binds to the CurrentStep property, using a converter to determine visibility.
                -->
                <Button Text="Finish"
                        Command="{Binding FinishCommand}"
                        IsVisible="{Binding CurrentStep, Converter={StaticResource StepToFinishVisibilityConverter}}"
                        Grid.Column="3" />
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
